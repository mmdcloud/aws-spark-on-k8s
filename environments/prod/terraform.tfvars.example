aws_region       = "us-west-2"
cluster_name     = "spark-eks-prod"
environment      = "prod"
vpc_cidr         = "10.100.0.0/16"
availability_zones = ["us-west-2a", "us-west-2b", "us-west-2c"]

system_node_group_desired_size   = 3
system_node_group_min_size       = 2
system_node_group_max_size       = 8
system_node_group_instance_types = ["m6i.xlarge", "m5.xlarge"]

executor_instance_families = ["r5d", "r6id", "r5", "r6i", "m5d", "m6id", "c5d"]
driver_instance_families   = ["m5", "m6i", "r5", "r6i"]

executor_cpu_limit    = "2000"
executor_memory_limit = "8000Gi"

event_log_retention_days = 90

tags = {
  Environment = "prod"
  ManagedBy   = "terraform"
  Platform    = "spark-on-k8s"
  Project     = "data-platform"
  CostCenter  = "engineering"
}
